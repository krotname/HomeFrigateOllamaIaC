# llama.cpp server for the OCR model on a Tesla P40 (Pascal, sm_61).
# CUDA 13 no longer compiles sm_61, so both stages stay on CUDA 12.x.
ARG CUDA_DEVEL_IMAGE=nvidia/cuda:12.9.1-devel-ubuntu24.04@sha256:020bc241a628776338f4d4053fed4c38f6f7f3d7eb5919fecb8de313bb8ba47c
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.9.1-runtime-ubuntu24.04@sha256:1287141d283b8f06f45681b56a48a85791398c615888b1f96bfb9fc981392d98
FROM ${CUDA_DEVEL_IMAGE} AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git libssl-dev ninja-build \
    && rm -rf /var/lib/apt/lists/*

# The same upstream commit black-qwen runs on this host; Qwen3-VL works with it.
ARG LLAMA_CPP_SHA=41abbfd599fbdd3470fcae0a1fb6530ad8403cd7
RUN test "${#LLAMA_CPP_SHA}" -eq 40 \
    && git init /src \
    && git -C /src remote add origin https://github.com/ggml-org/llama.cpp.git \
    && git -C /src fetch --depth 1 origin "${LLAMA_CPP_SHA}" \
    && git -C /src checkout --detach FETCH_HEAD \
    && test "$(git -C /src rev-parse HEAD)" = "${LLAMA_CPP_SHA}"

# Resolve the driver's SONAME while linking without a GPU in the build stage.
# The stub stays in this stage; the runtime receives the real host driver.
RUN ln -s libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 \
    && cmake -S /src -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS=-march=haswell \
        -DCMAKE_CXX_FLAGS=-march=haswell \
        -DCMAKE_EXE_LINKER_FLAGS=-Wl,-rpath-link,/usr/local/cuda/lib64/stubs \
        -DGGML_NATIVE=OFF -DGGML_AVX=ON -DGGML_AVX2=ON \
        -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_AVX512=OFF \
        -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=61 \
        -DGGML_CUDA_FORCE_MMQ=ON \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_UI=OFF -DLLAMA_USE_PREBUILT_UI=OFF \
    && cmake --build /build --target llama-server --parallel 4 \
    && mkdir -p /out/lib \
    && cp /build/bin/llama-server /out/ \
    && find /build -name '*.so*' -exec cp -P '{}' /out/lib/ ';'

FROM ${CUDA_RUNTIME_IMAGE}
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 libssl3t64 \
    && rm -rf /var/lib/apt/lists/*

ARG LLAMA_CPP_SHA=41abbfd599fbdd3470fcae0a1fb6530ad8403cd7
LABEL org.opencontainers.image.source="https://github.com/krotname/HomeFrigateOllamaIaC" \
      name.krot.llama-cpp.revision="${LLAMA_CPP_SHA}" \
      name.krot.cuda.architecture="61"
COPY --from=build /out /opt/llama
ENV LD_LIBRARY_PATH=/opt/llama/lib
USER 10001:10001
WORKDIR /opt/llama
ENTRYPOINT ["/opt/llama/llama-server"]
