[Unit]
Description=KRT Frigate Black camera presence watchdog
After=docker.service frigate-black.service
Requires=frigate-black.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/krt-camera-watchdog.sh
Environment=CAMERA_WATCHDOG_CONTAINER=frigate
Environment="CAMERA_WATCHDOG_TARGETS=cam1_ds_i202=192.168.1.12 cam2_ds_i551=192.168.1.65 cam3_ds_i200=192.168.1.51"
Environment=CAMERA_WATCHDOG_OFFLINE_THRESHOLD=10
Environment=CAMERA_WATCHDOG_ONLINE_THRESHOLD=2
TimeoutStartSec=120
RuntimeDirectory=krt-camera-watchdog
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/krt-camera-watchdog
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
